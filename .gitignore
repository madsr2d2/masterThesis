orca_stuff/**/*.bibtex
orca_stuff/**/*.smd.out
orca_stuff/**/*.tmp
orca_stuff/**/*.tmp.[0-9]*
orca_stuff/**/*.interp
orca_stuff/**/*.grd
orca_stuff/**/*.cosmo
orca_stuff/**/*.dat
orca_stuff/**/*_trj.xyz
orca_stuff/**/*allxyz*
orca_stuff/**/*goat*.xyz
orca_stuff/**/*ensemble*.xyz
orca_stuff/**/*.gz

# xtb scratch and its own conformer-search/optimiser output
orca_stuff/**/*xtbrestart*
orca_stuff/**/*xtberr*
orca_stuff/**/*xtbtopo.mol*
orca_stuff/**/xtbopt.log
orca_stuff/**/xtbopt.xyz
