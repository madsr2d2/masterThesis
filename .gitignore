__pycache__/
*.pyc
.ipynb_checkpoints/

# LibreOffice lock files (present only while a document is open)
.~lock.*#

# generated review dossiers -- rebuild with data/build_dossier.py
dossier*.html

# per-experiment curve dossier -- rebuild with data/curve_dossier.py
dossier/

# symbolic-regression run directories
outputs/

# fit figures -- rebuild in seconds with data/plot_fit.py from data/fits/*.json
figures/

# local interpreter
.venv/

# ORCA per-geometry-step restart guesses. An excited-state optimisation writes
# one TDDFT guess per step, ~2 MB each; 156 of them were tracked and came to
# 311 MB, six sevenths of the repository. They are scratch that ORCA rereads
# within a single run, not results -- the converged .gbw, .out, .xyz and .hess
# are what the calculation produced, and those are still tracked. Removed from
# the tree on 2026-09-04; still in history, so a clone still pays for them.
*_D[0-9][0-9][0-9][0-9][0-9].TDDFTGuess.gbw

# orca_stuff/ -- computational setup for the mechanism calculations. The
# calculations themselves run on the homelab server, so only the job
# definitions are tracked here: the .inp files and the small structures they
# chain between steps (job.xyz etc., ~13 MB total). Everything ORCA/xtb write
# as output or scratch is homelab-local and regenerates by rerunning the .inp
# against the tracked geometry -- some of it runs into gigabytes (GOAT
# conformer trajectories alone are 50 MB each, and cat/ alone had 3.6 GB of
# per-step ONIOM *.grad.tmp scratch across 77k files).

# third-party source trees and build products -- not thesis data
orca_stuff/openchemistry/
orca_stuff/comp_chem/
orca_stuff/build/

# ORCA output and scratch
orca_stuff/**/*.out
orca_stuff/**/*.gbw
