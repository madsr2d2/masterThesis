orca_stuff/**/xtblast.xyz
orca_stuff/**/.xtboptok
orca_stuff/**/*charges*
orca_stuff/**/*wbo*
orca_stuff/**/*lastscf*
orca_stuff/**/*carthess*
orca_stuff/**/*.bas[0-9]
orca_stuff/**/*hostnames*
orca_stuff/**/*.cjson
orca_stuff/**/*lastout*
orca_stuff/**/*vibspectrum*
orca_stuff/**/*pcgrad*
